# Smart Equipment Maintenance System (SEMS) - Environment Variables Configuration

# ==============================================================================
# EmailJS Service Configuration (Frontend & Backend Notification Dispatch)
# ==============================================================================
# Obtain from your EmailJS Dashboard: https://dashboard.emailjs.com/
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# ==============================================================================
# Database Configuration (Optional: defaults to SQLite sems.db if not specified)
# ==============================================================================
# To use MySQL instead of local SQLite, provide your credentials below:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sems_db

# ==============================================================================
# Flask Server Configuration
# ==============================================================================
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000
SECRET_KEY=sems_industrial_secure_secret_token_2026
